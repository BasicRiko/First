#define _CRT_SECURE_NO_WARNINGS 1         /*忽略vs对scanf()的警告*/
#include<stdio.h>

#define G 0.38f

int main() 
{
	float earth;

	float mars;

	printf("请输入你在地球上的体重：");


	scanf("%f", &earth);

	mars = earth * G;

	printf("你在地球上的体重是：%f\n", earth);

	printf("你在火星上的体重是：%f", mars);

	return 0;
