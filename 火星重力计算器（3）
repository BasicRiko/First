/* mars_weight.c -- 火星体重计算器
 * 练习范围：《C Primer Plus》第 3 章（变量、float、printf/scanf、#define、算术）
 * 编译：gcc mars_weight.c -o mars_weight
 */
#include <stdio.h>
#define MARS_FACTOR 0.38    /* 火星表面重力约为地球的 38% */
int main(void)
{
    float earth_weight;     /* 用户在地球上的体重（千克） */
    float mars_weight;      /* 换算出来的火星体重（千克） */
    printf("请输入你在地球上的体重（千克）：");
    scanf("%f", &earth_weight);         /* %f 读入 float，别忘了 & */
    mars_weight = earth_weight * MARS_FACTOR;   /* 核心就是这一句 */
    printf("你在地球上的体重是 %f 千克。\n", earth_weight);
    printf("你在火星上的体重是 %f 千克。\n", mars_weight);
    return 0;
}

